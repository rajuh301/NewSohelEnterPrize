{
  "services": {
    "client": {
      "root": "client/",
      "framework": "nextjs"
    },
    "server": {
      "root": "server/",
      "framework": "express",
      "entrypoint": "index.ts"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "server" } },
    { "source": "/(.*)", "destination": { "service": "client" } }
  ]
}